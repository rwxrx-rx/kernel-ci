# =====================================================================
# manifest/device.env
# Single source of truth for "which kernel / which device tree".
# Every workflow reads this file — change device here, not in the YAML.
# =====================================================================

DEVICE_NAME="POCO M3 Pro 5G / Redmi Note 10 5G"
CODENAME="camellia"
ARCH="arm64"
KERNEL_VERSION_MAJOR="4"
KERNEL_VERSION_MINOR="14"
DEFCONFIG="camellia_defconfig"     # path resolved as arch/${ARCH}/configs/${DEFCONFIG}

# Default kernel source + device tree. Both can be overridden per-run via
# workflow_dispatch inputs (device_tree_repo / device_tree_branch), which is
# how you swap device trees without editing this file.
KERNEL_REPO="https://github.com/rwxrx-rx/kernel_xiaomi_mt6833"
KERNEL_BRANCH="lineage-23.2-fts-fixed"

# AnyKernel3 template used to package the final boot image
ANYKERNEL_REPO="https://github.com/osm0sis/AnyKernel3"
ANYKERNEL_BRANCH="master"

# Output naming
KERNEL_NAME="Camellia-Kernel"
