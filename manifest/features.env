# =====================================================================
# manifest/features.env
# Optional kernel feature toggles. Each is selected independently as a
# boolean input in workflow_dispatch (GitHub Actions dispatch forms
# don't support real multi-select checkboxes, so "pick what you want"
# becomes one on/off switch per feature instead of a single dropdown).
# scripts/patch_features.sh reads this file and applies whichever ones
# were turned on for the run.
# =====================================================================

# --- WireGuard --------------------------------------------------------
# In-kernel WireGuard. Upstream since 5.6; on 4.14 it needs the
# standalone backport module (wireguard-linux-compat).
WIREGUARD_REPO="https://git.zx2c4.com/wireguard-linux-compat"
WIREGUARD_BRANCH="master"
WIREGUARD_DEFCONFIG="CONFIG_WIREGUARD=y"

# --- Baseband-guard (BBG) ----------------------------------------------
# LSM that blocks unauthorized writes to baseband/bootchain partitions.
BBG_SETUP_URL="https://github.com/vc-teahouse/Baseband-guard/raw/main/setup.sh"
BBG_DEFCONFIG="CONFIG_SECURITY_BASEBAND_GUARD=y"

# --- ThinLTO + -O3 -------------------------------------------------------
THINLTO_DEFCONFIG="CONFIG_LTO_CLANG=y
CONFIG_LTO_CLANG_THIN=y
CONFIG_THINLTO=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE_O3=y"

# --- ZRAM + zstd ---------------------------------------------------------
ZRAM_ZSTD_DEFCONFIG="CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_ZPOOL=y
CONFIG_ZBUD=y"

# --- TCP BBR / Westwood --------------------------------------------------
TCP_BBR_DEFCONFIG="CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG=\"bbr\""
TCP_WESTWOOD_DEFCONFIG="CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_DEFAULT_WESTWOOD=y
CONFIG_DEFAULT_TCP_CONG=\"westwood\""
# BBR and Westwood are mutually exclusive as the *default* congestion
# algorithm — patch_features.sh errors out if both toggles are on.

# --- TTL / Hop-Limit spoofing --------------------------------------------
# NOTE: there is no single canonical "TTL spoof kernel patch" repo the
# way there is for BBG/susfs — most kernels that advertise this feature
# actually do it via a boot-time sysctl (net.ipv4.ip_default_ttl /
# net.ipv6.conf.*.hop_limit), not a compiled-in patch, because it needs
# no kernel change at all: sysctl already exposes both knobs on stock
# kernels. patch_features.sh implements it that way (writes an init
# script AnyKernel3 installs to /system/etc/init or a boot-time sysctl.d
# entry) rather than pretending there's a patch to fetch. If you have a
# specific TTL-spoof kernel patch in mind, drop its URL here and I'll
# wire it in properly instead.
TTL_SPOOF_DEFAULT_VALUE="65"

# --- DroidSpace (Linux containers on Android) ----------------------------
# Droidspaces (droidspaces.org) is a userspace daemon/APK, not a kernel
# source patch — nothing gets compiled into the kernel image for it.
# What it needs from the kernel is standard Linux namespace/cgroup
# support, which most Android kernels already carry; this just makes
# sure those configs are actually on.
DROIDSPACE_DEFCONFIG="CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_VETH=y
CONFIG_BRIDGE=y"
