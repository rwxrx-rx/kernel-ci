# =====================================================================
# manifest/toolchains.env
# Add a new clang flavor here and it becomes selectable in the
# workflow_dispatch "clang" dropdown (keep the dropdown list in
# build-kernel.yml in sync with the keys below).
# =====================================================================

# --- AOSP Clang (official prebuilt, pinned release) --------------------
AOSP_CLANG_REPO="https://android.googlesource.com/platform/prebuilts/clang/host/linux-x86"
AOSP_CLANG_REF="master-kernel-build-2024"
AOSP_CLANG_SUBDIR="clang-r487747c"     # update to whatever tag you pin

# --- ProtonClang ---------------------------------------------------------
PROTON_CLANG_REPO="https://github.com/kdrag0n/proton-clang"
PROTON_CLANG_BRANCH="master"

## --- Binutils / GCC (only needed if a toolchain above doesn't bundle it)
# NOTE: Google removed the actual GCC 4.9 binaries from the official
# AOSP googlesource repos years ago ("gcc-4.9: remove GCC from Android")
# — cloning those now gets you an empty tree with no bin/. LineageOS
# still mirrors the real binaries on its GitHub repos, but only on
# version-specific branches (not the default branch) — lineage-19.1 is
# a known-good one, used the same way in community kernel-build guides.
GCC64_REPO="https://github.com/LineageOS/android_prebuilts_gcc_linux-x86_aarch64_aarch64-linux-android-4.9"
GCC32_REPO="https://github.com/LineageOS/android_prebuilts_gcc_linux-x86_arm_arm-linux-androideabi-4.9"
GCC_BRANCH="lineage-19.1"
