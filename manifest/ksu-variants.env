# =====================================================================
# manifest/ksu-variants.env
# One entry per supported KernelSU fork. scripts/patch_ksu.sh sources
# this file and picks the block matching $KSU_VARIANT.
#
# Every variant is installed via its own setup.sh (each fork mirrors the
# upstream KernelSU installer convention: curl setup.sh | bash -s <ref>),
# so adding a new fork later is just adding a new block here — nothing
# in the workflow YAML has to change.
#
# NOTE on "xxksu": this is a placeholder slot. I could not verify a
# canonical public repo for a fork by that exact name at time of writing.
# Point XXKSU_SETUP_URL / XXKSU_REF at whatever fork you mean before
# selecting it in workflow_dispatch, otherwise the build will fail fast
# with a clear error instead of silently doing the wrong thing.
# =====================================================================

# --- KernelSU-Next (legacy / manual-hook mode, non-kprobe) -----------
KSUN_SETUP_URL="https://raw.githubusercontent.com/KernelSU-Next/KernelSU-Next/next/kernel/setup.sh"
KSUN_REF="legacy"

# --- ReSukiSU ----------------------------------------------------------
RESUKISU_SETUP_URL="https://raw.githubusercontent.com/ReSukiSU/ReSukiSU/main/kernel/setup.sh"
RESUKISU_REF=""     # upstream script takes no ref for the default branch

# --- xxKSU (fill in — see note above) ---------------------------------
XXKSU_SETUP_URL="https://raw.githubusercontent.com/CHANGE-ME/xxKSU/main/kernel/setup.sh"
XXKSU_REF="main"

# --- SukiSU Ultra --------------------------------------------------------
SUKISU_SETUP_URL="https://raw.githubusercontent.com/SukiSU-Ultra/SukiSU-Ultra/main/kernel/setup.sh"
SUKISU_REF="nongki"   # nongki branch = non-GKI device support, susfs integrated manually

# --- Wild KSU (WildKernels) --------------------------------------------
WILDKSU_SETUP_URL="https://raw.githubusercontent.com/WildKernels/GKI_KernelSU_SUSFS/main/kernel/setup.sh"
WILDKSU_REF="main"

# =====================================================================
# susfs4ksu — pinned to the 4.14 branch, tag 2.2.0. WildKernels maintain
# an actively-synced 4.14 branch of susfs4ksu; that's the default source
# because it tracks non-GKI kernels more closely than upstream simonpunk.
# Override SUSFS_REPO to point at gitlab.com/simonpunk/susfs4ksu instead
# if you want the upstream source for a given variant.
# =====================================================================
SUSFS_REPO="https://gitlab.com/simonpunk/susfs4ksu"
SUSFS_BRANCH="kernel-4.14"
SUSFS_TAG="2.2.0"

# --- OverlayFS module-mount support + Mountify (manual hook) ----------
# Mountify ships as a KernelSU/Magisk-compatible module, not a kernel
# patch — it needs CONFIG_OVERLAY_FS=y in the defconfig and the manual
# (non-kprobe) hook variant of whichever KSU fork you picked above.
MOUNTIFY_REPO="https://github.com/backslashxx/mountify"
MOUNTIFY_BRANCH="master"
