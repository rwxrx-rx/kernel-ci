# =====================================================================
# manifest/ksu-variants.env
# Sources rewritten against a proven, battle-tested reference build
# (same camellia/mt6833 device, ReSukiSU + susfs v2.2.0 confirmed
# working end to end). See scripts/patch_ksu.sh for how each is used —
# they are NOT interchangeable, each fork has its own setup logic now.
# =====================================================================

# --- KernelSU-Next (legacy / manual hook) ------------------------------
# Kept as-is: this is the one already verified working end to end in
# this pipeline (5-file manual hook + Safe Mode, all clean).
KSUN_SETUP_URL="https://raw.githubusercontent.com/KernelSU-Next/KernelSU-Next/next/kernel/setup.sh"
KSUN_REF="legacy"

# --- ReSukiSU ------------------------------------------------------------
# Pinned to an exact commit, not a floating branch — this pipeline's
# SUSFS Inline hook injector (resukisu_helpers/apply_resukisu_inline_hooks.py)
# and the ABI/version assertions in patch_ksu.sh depend on this exact
# revision count (4379) and ABI version (35079). Bumping this requires
# re-deriving both numbers against the new commit — don't just move the
# pin without updating KSU_EXPECTED_REV_COUNT / KSU_EXPECTED_VERSION in
# patch_ksu.sh to match, or the fail-closed checks will (correctly) abort.
RESUKISU_REPO="https://github.com/ReSukiSU/ReSukiSU.git"
RESUKISU_BRANCH="main"
RESUKISU_PINNED_COMMIT="cdce8bb8c8bf2167d21751e39ca6cdc4ad154678"
RESUKISU_EXPECTED_REV_COUNT="4379"
RESUKISU_EXPECTED_ABI="35079"

# --- xxKSU --------------------------------------------------------------
# Resolved: "xxKSU" = backslashxx's KernelSU fork (backslashxx is a known
# KernelSU contributor; this was an unverified placeholder for a long
# time — confirmed against the reference build's own fork table).
XXKSU_REPO="https://github.com/backslashxx/KernelSU.git"
XXKSU_BRANCH="main"

# --- SukiSU Ultra ----------------------------------------------------------
SUKISU_REPO="https://github.com/SukiSU-Ultra/SukiSU-Ultra.git"
SUKISU_BRANCH="main"

# =====================================================================
# susfs — now installed as a pre-merged whole-file tree overlay
# (patches/susfs_v220/tree/, copied from the same proven reference),
# NOT fetched live and fuzzy-patched anymore. See scripts/patch_susfs.sh.
# SUSFS_TAG is kept only for the changelog/Telegram message text.
# =====================================================================
SUSFS_TAG="2.2.0"

# --- OverlayFS module-mount support + Mountify (manual hook) ----------
MOUNTIFY_REPO="https://github.com/backslashxx/mountify"
MOUNTIFY_BRANCH="master"
